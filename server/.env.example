NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/haatly
CLIENT_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=edGPpc8k2mwGWsNN_OqOxG75BuyCfQfm1O5RqZZ-0xUMsMrAlX_mOwcwqN_DPCKQ
JWT_EXPIRES_IN=7d

# Number of reverse proxies in front of the API (0 locally).
TRUST_PROXY=0
AUTH_RATE_LIMIT_MAX=20


# AI features work without these (rules only). To let a model help, set the provider
# to anthropic and add a key. Calls are capped per rolling 24 hours.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
AI_MAX_CALLS_PER_DAY=500


# Wallet payments. "none" = cash on delivery only. "sandbox" simulates a wallet gateway
# for development (refused in production).
PAYMENT_PROVIDER=none
# Optional. Defaults to a secret derived from JWT_SECRET.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=15