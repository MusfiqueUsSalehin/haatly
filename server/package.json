{
  "name": "haatly-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Haatly API server",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
